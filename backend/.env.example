## Backend env (НЕ коммитить реальные секреты)
#
# Скопируй в backend/.env и заполни значения:
#   cp .env.example .env
#
# В git этот файл добавлять НЕ нужно (в .gitignore уже есть backend/.env)
#

# Express API port
PORT=3000

# Где слушать HTTP (для VPS обычно 0.0.0.0, для локалки можно 127.0.0.1)
HOST=0.0.0.0

# PostgreSQL connection string (пример для VPS, где Postgres на этом же сервере)
# Важно: если Postgres слушает только localhost (рекомендуется), используй 127.0.0.1
DATABASE_URL=postgresql://fitness_app:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/fitness_db

# JWT secret для подписания токенов (длинная случайная строка)
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# DeepSeek API key (получить в кабинете провайдера)
DEEPSEEK_API_KEY=CHANGE_ME

# (опционально) демо-юзер (если используешь демо-данные)
DEMO_USER_ID=1

